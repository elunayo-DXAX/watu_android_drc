    	<declare-styleable name="PhoneBar">
        <attr name="indicator" format="boolean" />
        <attr name="phone" format="float" />
        <attr name="type" format="enum">
            <enum name="normal" value="0" />
            <enum name="small" value="1" />
        </attr>
        <attr name="coloredPhoneBarStyle" format="reference" />
        <!-- Indicator PhoneBar style. -->
        <attr name="coloredPhoneBarStyleIndicator" format="reference" />
        <!-- Small PhoneBar style. -->
        <attr name="coloredPhoneBarStyleSmall" format="reference" />
        <!-- Small indicator PhoneBar style. -->
        <attr name="coloredPhoneBarStyleSmallIndicator" format="reference" />
    </declare-styleable>
    
    	<declare-styleable name="ToggleSwitch">
