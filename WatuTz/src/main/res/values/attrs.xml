<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="CircleImage">
        <attr name="img_radius" format="float" />
    </declare-styleable>
    
     <declare-styleable name="FirmaTextView">
        <attr name="firmatypeface" format="enum">
            <enum name="firmaLight" value="0" />
            <enum name="firmaBold" value="1" />
            <enum name="firmaMedium" value="2" />
          
        </attr>
    </declare-styleable>


      <declare-styleable name="UIParallaxScroll">
        <attr name="headerView" format="integer"/>
        <attr name="backgroundView" format="integer"/>
    </declare-styleable>
    
      <declare-styleable name="PlacesAutoCompleteEditText" >
        <attr name="item_layout" format="reference" />
        <attr name="item_text_id" format="reference" />
        <attr name="north_bound" format="float" />
        <attr name="south_bound" format="float" />
        <attr name="east_bound" format="float" />
        <attr name="west_bound" format="float" />
    </declare-styleable>
    
    
    <declare-styleable name="SlidingUpPanelLayout">
        <attr name="collapsedContentHeight" format="dimension" />
        <attr name="shadowHeight" format="dimension" />
        <attr name="fadeColor" format="color" />
        <attr name="flingVelocity" format="integer" />
        <attr name="dragView" format="reference" />
    </declare-styleable>
    
  <declare-styleable name="MaterialRippleLayout">
        <attr name="rippleColor" format="color" />
        <attr name="rippleDimension" format="dimension" />
        <attr name="rippleOverlay" format="boolean" />
        <attr name="rippleAlpha" format="float" />
        <attr name="rippleDuration" format="integer" />
        <attr name="rippleFadeDuration" format="integer" />
        <attr name="rippleHover" format="boolean" />
        <attr name="rippleBackground" format="color" />
        <attr name="rippleDelayClick" format="boolean" />
        <attr name="ripplePersistent" format="boolean" />
