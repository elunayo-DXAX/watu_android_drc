<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:descendantFocusability="blocksDescendants" >

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/newDeviceUpgradeImageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:background="@xml/rounded_list_transparent_white_faint_stroke">

            <ImageView
                android:id="@+id/newDeviceUpgradeImage"
                android:layout_width="100dp"
                android:layout_height="150dp"
                android:src="@drawable/ics_icon_device" />

            <com.watutz.app.font.FirmaTextView
                android:id="@+id/newDeviceUpgradeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/newDeviceUpgradeImage"
                android:layout_marginTop="10dp"
                android:text="@string/name"
                android:textColor="@color/theme_color"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaBold" />
        </RelativeLayout>
    </RelativeLayout>


</FrameLayout>