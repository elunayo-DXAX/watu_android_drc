<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_height="match_parent">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <ImageView
            android:layout_width="60dp"
            android:layout_centerHorizontal="true"
            android:src="@drawable/ic_logo"
            android:layout_marginTop="10dp"
            android:tint="@color/white"
            android:layout_height="20dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/headerView"
            android:layout_height="wrap_content">

            <com.watutz.app.view.MaterialRippleLayout
                style="@style/RippleStyle"
                android:layout_width="50dp"
                android:layout_centerVertical="true"
                android:id="@+id/backRips"
                android:layout_height="50dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerInParent="true"
                        app:srcCompat="@drawable/ics_back" />

                </RelativeLayout>
            </com.watutz.app.view.MaterialRippleLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/btnUserIcon"
                android:layout_toRightOf="@+id/backRips"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="50dp"
                    android:layout_marginTop="10dp"
                    android:id="@+id/inView"
                    android:layout_centerVertical="true"
                    android:background="@xml/rounded_circle_white_small"
                    android:layout_height="50dp">

                    <com.watutz.app.font.FirmaTextView
                        android:id="@+id/userInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_centerInParent="true"
                        android:text="JM"
                        android:textColor="@color/theme_color"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaBold" />


                </RelativeLayout>

                <com.watutz.app.font.FirmaTextView
                    android:id="@+id/userHelloH"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/inView"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:text="@string/helloicon"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaBold" />

                <com.watutz.app.font.FirmaTextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/userHelloH"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_toRightOf="@+id/inView"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaBold" />
            </RelativeLayout>

            <com.watutz.app.view.MaterialRippleLayout
                style="@style/RippleStyle"
                android:layout_width="50dp"
                android:layout_alignParentRight="true"
                android:id="@+id/notificationRips"
                android:layout_height="50dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="@drawable/ics_notification_bell_empty" />

                </RelativeLayout>
            </com.watutz.app.view.MaterialRippleLayout>



        </RelativeLayout>


        <FrameLayout
            android:id="@+id/chat_container"
            android:layout_width="match_parent"
            android:layout_below="@+id/headerView"
            android:layout_height="match_parent" />

        <include layout="@layout/loading_view" />
    </RelativeLayout>



</FrameLayout>