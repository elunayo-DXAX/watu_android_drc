<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_container"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginTop="@dimen/tab_heightxx"
    android:background="@color/white"
    android:orientation="vertical"

    >


    <com.watutz.app.view.MaterialRippleLayout
        style="@style/RippleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="5dp"
        app:rippleColor="@color/transparent">

        <RelativeLayout
            android:id="@+id/btnCancel"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@xml/rounded_circle_red_small"
            android:gravity="center"
            android:padding="5dp">

            <com.watutz.app.font.FontView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/dw_cancel"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_xlarge" />
        </RelativeLayout>
    </com.watutz.app.view.MaterialRippleLayout>


    <com.watutz.app.view.MaterialRippleLayout
        style="@style/RippleStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="5dp"
        app:rippleColor="@color/transparent">

        <RelativeLayout
            android:id="@+id/btnWebBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@xml/rounded_circle_green_small"
            android:gravity="center"
            android:padding="5dp">

            <com.watutz.app.font.FontView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/dw_back"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_xlarge" />
        </RelativeLayout>
    </com.watutz.app.view.MaterialRippleLayout>

</RelativeLayout>

