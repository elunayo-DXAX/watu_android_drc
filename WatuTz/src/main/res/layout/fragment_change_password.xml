<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="100dp"
            android:id="@+id/seekBarView"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">


            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:progress="3"
                android:padding="0dp"
                android:paddingEnd="0dp"
                android:paddingStart="0dp"
                android:max="3"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@color/transparent"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true">
            </SeekBar>

        </RelativeLayout>



        <RelativeLayout
            android:id="@+id/topView"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/seekBarView"
            android:layout_height="wrap_content">

            <com.watutz.app.font.FirmaTextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_centerHorizontal="true"
                android:text="@string/confirmyourpin"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_xlarge"
                app:firmatypeface="firmaBold"

                />

            <com.watutz.app.font.FirmaTextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:text="@string/enterthesamepin"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_medium_small"
                app:firmatypeface="firmaMedium"

                />


        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/topView">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:padding="10dp"
                    android:layout_height="match_parent">


                    <LinearLayout
                        android:id="@+id/codesView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <com.watutz.app.font.FirmaTextView
                            android:id="@+id/createH"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="10dp"
                            android:text="@string/enterpin"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold"

                            />


                        <RelativeLayout
                            android:id="@+id/code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/createH"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="10dp">


                            <RelativeLayout
                                android:id="@+id/code1"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeEditText1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:gravity="center"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textAllCaps="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/code2"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginLeft="10dp"
                                android:layout_toRightOf="@+id/code1"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeEditText2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/code3"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginLeft="10dp"
                                android:layout_toRightOf="@+id/code2"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeEditText3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>


                            <RelativeLayout
                                android:id="@+id/code4"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginLeft="10dp"
                                android:layout_toRightOf="@+id/code3"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeEditText4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:imeOptions="actionDone"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>


                        </RelativeLayout>


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_below="@+id/createH"
                            android:layout_marginTop="10dp"
                            android:background="@xml/rounded_list_transparent_dark_light_small"
                            android:gravity="center_vertical"
                            android:visibility="gone">


                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/transparent"
                                android:gravity="left|center_vertical"
                                android:hint="@string/type"
                                android:imeOptions="actionNext"
                                android:inputType="phone"
                                android:maxLength="4"
                                android:minHeight="50dp"
                                android:paddingLeft="25dp"
                                android:singleLine="true"
                                android:textColor="@color/theme_color"
                                android:textColorHint="@color/theme_hint"
                                android:textSize="@dimen/textsize_medium_small" />


                            <com.watutz.app.view.MaterialRippleLayout
                                style="@style/RippleStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="5dp"
                                app:rippleColor="@color/transparent">

                                <RelativeLayout
                                    android:layout_width="50dp"
                                    android:layout_height="50dp">

                                    <com.watutz.app.font.FontView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:gravity="center"
                                        android:padding="5dp"
                                        android:text="@string/dw_eye"
                                        android:textColor="@color/theme_grey_dark"
                                        android:textSize="@dimen/textsize_large" />

                                </RelativeLayout>


                            </com.watutz.app.view.MaterialRippleLayout>


                        </RelativeLayout>


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_below="@+id/confirmH"
                            android:layout_marginTop="10dp"
                            android:background="@xml/rounded_list_transparent_dark_light_small"
                            android:gravity="center_vertical"
                            android:visibility="gone">


                            <EditText
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/transparent"
                                android:gravity="left|center_vertical"
                                android:hint="@string/type"
                                android:imeOptions="actionDone"
                                android:inputType="phone"
                                android:maxLength="4"
                                android:minHeight="50dp"
                                android:paddingLeft="25dp"
                                android:singleLine="true"
                                android:textColor="@color/theme_color"
                                android:textColorHint="@color/theme_hint"
                                android:textSize="@dimen/textsize_medium_small" />


                            <com.watutz.app.view.MaterialRippleLayout
                                style="@style/RippleStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="10dp"
                                android:layout_marginRight="5dp"
                                app:rippleColor="@color/transparent">

                                <RelativeLayout
                                    android:layout_width="50dp"
                                    android:layout_height="50dp">

                                    <com.watutz.app.font.FontView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:gravity="center"
                                        android:padding="5dp"
                                        android:text="@string/dw_eye"
                                        android:textColor="@color/theme_grey_dark"
                                        android:textSize="@dimen/textsize_large" />

                                </RelativeLayout>


                            </com.watutz.app.view.MaterialRippleLayout>

                        </RelativeLayout>



                        <com.watutz.app.font.FirmaTextView
                            android:id="@+id/confirmH"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/code"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="15dp"
                            android:text="@string/confirmpin"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold"

                            />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/confirmH"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="10dp">


                            <RelativeLayout
                                android:id="@+id/codeConfirm1"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeConfirmEditText1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:gravity="center"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textAllCaps="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/codeConfirm2"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginLeft="10dp"
                                android:layout_toRightOf="@+id/codeConfirm1"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeConfirmEditText2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/codeConfirm3"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginLeft="10dp"
                                android:layout_toRightOf="@+id/codeConfirm2"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeConfirmEditText3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_marginLeft="10dp"
                                android:layout_toRightOf="@+id/codeConfirm3"
                                android:background="@xml/rounded_list_transparent_square_small"
                                android:gravity="center_vertical">


                                <EditText
                                    android:id="@+id/codeConfirmEditText4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_centerVertical="true"
                                    android:background="@color/transparent"
                                    android:enabled="false"
                                    android:gravity="center"
                                    android:imeOptions="actionDone"
                                    android:inputType="phone"
                                    android:maxLength="1"
                                    android:minHeight="50dp"
                                    android:singleLine="true"
                                    android:textColor="@color/theme_color"
                                    android:textColorHint="@color/theme_grey"
                                    android:textSize="@dimen/textsize_large" />

                            </RelativeLayout>


                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/wrongView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/code"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="25dp"
                            android:layout_marginBottom="20dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/icWrong"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ics_emergency"
                                android:visibility="gone" />

                            <com.watutz.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="10dp"
                                android:layout_toRightOf="@+id/icWrong"
                                android:gravity="center"
                                android:text="@string/pindoesnotmatch"
                                android:textColor="@color/theme_orange"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaBold" />


                        </RelativeLayout>







                    </LinearLayout>

                <com.watutz.app.view.MaterialRippleLayout
                    android:id="@+id/nextRips"
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_below="@+id/codesView"
                    android:layout_marginTop="20dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_button">

                        <com.watutz.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/confirmpin"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium_small"
                            app:firmatypeface="firmaBold" />


                    </RelativeLayout>

                </com.watutz.app.view.MaterialRippleLayout>

                </RelativeLayout>



            </ScrollView>

        </RelativeLayout>





    </RelativeLayout>



</RelativeLayout>