<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:background="@color/black">


        <RelativeLayout
            android:id="@+id/topView"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">



            <com.watutz.app.font.FirmaTextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/forgotpin"
                android:layout_centerHorizontal="true"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_large"
                app:firmatypeface="firmaBold"

                />

            <com.watutz.app.font.FirmaTextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:lineSpacingExtra="5dp"
                android:text="@string/enterregisterphone"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaMedium"

                />


        </RelativeLayout>



        <com.watutz.app.font.FirmaTextView
            android:id="@+id/mobileH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enterphonenumber"
            android:layout_below="@+id/topView"
            android:layout_marginTop="35dp"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_small"
            app:firmatypeface="firmaBold"

            />


        <RelativeLayout
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:layout_below="@+id/mobileH"
            android:background="@xml/rounded_list_transparent_white_stroke"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/phoneNumberEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/ccc"
                android:background="@color/transparent"
                android:gravity="left|center_vertical"
                android:hint="0000 000 000"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:minHeight="50dp"
                android:paddingLeft="10dp"
                android:singleLine="true"
                android:textColor="@color/theme_color"
                android:textColorHint="@color/theme_hint"
                android:textSize="@dimen/textsize_medium" />


            <ImageView
                android:layout_width="20dp"
                android:layout_centerVertical="true"
                android:id="@+id/ccc"
                android:layout_marginLeft="15dp"
                android:visibility="gone"
                android:src="@drawable/ics_country_tanzania"
                android:layout_height="20dp"/>


            <com.hbb20.CountryCodePicker
                android:id="@+id/ccp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:ccpDialog_searchEditTextTint="@color/theme_hint"
                app:ccpDialog_textColor="@color/theme_color"
                app:ccp_defaultNameCode="TZ"
                app:ccp_autoFormatNumber="false"
                android:visibility="gone"
                app:ccp_customMasterCountries="TZ"
                app:ccp_showNameCode="false"
                app:ccp_showPhoneCode="false"
                app:ccp_textSize="@dimen/textsize_small" />


        </RelativeLayout>




        <com.watutz.app.font.FirmaTextView
            android:id="@+id/idNumberH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/idnumberh"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/phone"
            android:textColor="@color/theme_color"
            android:textSize="@dimen/textsize_small"
            app:firmatypeface="firmaMedium"

            />




        <RelativeLayout
            android:id="@+id/idNumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/idNumberH"
            android:visibility="gone"
            android:layout_marginTop="15dp"
            android:background="@xml/rounded_list_transparent_dark_light_small"
            android:gravity="center_vertical">


            <EditText
                android:id="@+id/idNumberEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent"
                android:gravity="left|center_vertical"
                android:hint="@string/idnumber"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:minHeight="50dp"
                android:paddingLeft="10dp"
                android:singleLine="true"
                android:textColor="@color/theme_color"
                android:textColorHint="@color/theme_hint"
                android:textSize="@dimen/textsize_small" />





        </RelativeLayout>





        <com.watutz.app.view.MaterialRippleLayout
            android:id="@+id/resetRips"
            style="@style/RippleStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/phone"
            android:layout_marginTop="40dp"
            app:rippleColor="@color/transparent">

            <RelativeLayout
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@xml/rounded_list_button">

                <com.watutz.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/reset"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaBold" />


            </RelativeLayout>

        </com.watutz.app.view.MaterialRippleLayout>


    </RelativeLayout>


    <include layout="@layout/loading_view" />

</RelativeLayout>