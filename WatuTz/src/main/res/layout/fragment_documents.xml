<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:background="@color/black">



                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <!-- Title -->
                    <com.watutz.app.font.FirmaTextView
                        android:id="@+id/txtSubTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="18dp"
                        android:layout_marginBottom="18dp"
                        android:text="@string/getyourdocumentshere"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_medium_small"
                        app:firmatypeface="firmaMedium" />

                    <!-- Loan Agreement -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/loanAgreement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtSubTitle"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:background="@xml/rounded_list_black_light"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:padding="4dp">

                        <com.watutz.app.view.MaterialRippleLayout
                            style="@style/RippleStyle"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            app:rippleColor="@color/transparent">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:id="@+id/btnLoanAgreement"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:id="@+id/documentIcon"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ics_icon_document" />

                                <com.watutz.app.font.FirmaTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_toEndOf="@+id/documentIcon"
                                    android:layout_marginStart="12dp"
                                    android:text="@string/loanagreementform"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_medium_small"
                                    app:firmatypeface="firmaMedium" />


                            </RelativeLayout>

                        </com.watutz.app.view.MaterialRippleLayout>

                    </androidx.appcompat.widget.LinearLayoutCompat>


                    <!-- Account Statements -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/loanAgreement"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:background="@xml/rounded_list_black_light"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:padding="4dp">

                        <com.watutz.app.view.MaterialRippleLayout
                            style="@style/RippleStyle"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            app:rippleColor="@color/transparent">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:id="@+id/btnStatement"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:id="@+id/statementIcon"
                                    android:layout_centerVertical="true"
                                    android:src="@drawable/ics_icon_document" />

                                <com.watutz.app.font.FirmaTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_toEndOf="@+id/statementIcon"
                                    android:layout_marginStart="12dp"
                                    android:text="@string/accountstatements"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_medium_small"
                                    app:firmatypeface="firmaMedium" />


                            </RelativeLayout>
                        </com.watutz.app.view.MaterialRippleLayout>
                    </androidx.appcompat.widget.LinearLayoutCompat>


                </RelativeLayout>
            </RelativeLayout>





    <include layout="@layout/loading_view" />

</RelativeLayout>