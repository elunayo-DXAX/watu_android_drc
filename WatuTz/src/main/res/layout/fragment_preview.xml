<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:fillViewport="true"
        android:layout_height="match_parent">



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black">


            <RelativeLayout
                android:id="@+id/topView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black">




                <com.synnapps.carouselview.CarouselView
                    android:id="@+id/previewImagesView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/theme_green"
                    app:fillColor="@color/white"
                    app:indicatorGravity="top|center_horizontal"
                    app:pageColor="@color/theme_green"
                    app:radius="5dp"
                    app:pageTransformInterval="5"
                    app:indicatorVisibility="gone"
                    app:indicatorMarginVertical="10dp"
                    app:strokeColor="@color/white"
                    app:strokeWidth="1dp" />



            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/midView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_margin="20dp"
                android:padding="10dp"
                android:background="@xml/rounded_list_theme_trans"
                >

                <com.watutz.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/termsandconditions"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium"
                    app:firmatypeface="firmaBold" />



                <RelativeLayout
                    android:id="@+id/chkView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="10dp">


                    <CheckBox
                        android:id="@+id/chkTerms"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_centerVertical="true"
                        android:buttonTint="@drawable/chk_selector"
                        android:padding="2dp"
                        android:textColor="@color/theme_color" />


                    <com.watutz.app.font.FirmaTextView
                        android:id="@+id/acceptTheH"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_toRightOf="@+id/chkTerms"
                        android:text="@string/acceptthe"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_medium_small"
                        app:firmatypeface="firmaLight" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ics_circle_tick"
                        android:visibility="gone"
                        app:tint="@color/white" />




                    <com.watutz.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="5dp"
                        android:layout_toRightOf="@+id/acceptTheH"
                        app:rippleColor="@color/transparent">

                        <RelativeLayout
                            android:id="@+id/btnTerms"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">


                            <com.watutz.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/termsText"
                                android:text="@string/termsandconditions"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_medium_small"
                                app:firmatypeface="firmaBold" />


                        </RelativeLayout>

                    </com.watutz.app.view.MaterialRippleLayout>


                    <com.watutz.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/chkTerms"
                        android:layout_toRightOf="@+id/chkTerms"
                        android:layout_marginTop="20dp"
                        android:text="@string/foryoutogetstarted"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_medium_small"
                        app:firmatypeface="firmaLight" />



                </RelativeLayout>

                <com.watutz.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="20dp"
                    android:layout_below="@+id/chkView"
                    android:layout_marginLeft="20dp"
                    android:layout_margin="10dp"
                    android:layout_centerHorizontal="true"
                    app:rippleColor="@color/transparent">


                    <RelativeLayout
                        android:id="@+id/btnGetStarted"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@xml/rounded_list_transparent_white_stroke">


                        <com.watutz.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:id="@+id/acceptText"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/accept"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium"
                            app:firmatypeface="firmaBold" />


                    </RelativeLayout>

                </com.watutz.app.view.MaterialRippleLayout>



            </RelativeLayout>




        </RelativeLayout>
    </ScrollView>

</RelativeLayout>