<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_margin="5dp"
    android:background="@color/black"
    android:descendantFocusability="blocksDescendants"
    android:layout_height="wrap_content" 
  >
    <RelativeLayout 
            android:layout_width="match_parent"
            android:background="@xml/rounded_list_button_black_dark"
            android:id="@+id/placeBack"
		     android:padding="10dp"
		     android:maxHeight="150dp"
            android:layout_height="wrap_content">
            
        <RelativeLayout 
            android:layout_width="wrap_content"
            android:padding="5dp"
			android:layout_toLeftOf="@+id/indicator"
            android:layout_centerVertical="true"
            android:layout_height="wrap_content">
            
               <ImageView
			        android:id="@+id/icon"
			        android:layout_width="25dp"
			        android:src="@drawable/ics_notification_general"
				   android:layout_centerVertical="true"
			        android:scaleType="centerCrop"
			        android:layout_height="25dp"
			        />
  
               <RelativeLayout 
                   android:layout_width="wrap_content"
                   android:layout_centerVertical="true"
                   android:layout_toRightOf="@+id/icon"
                   android:layout_height="wrap_content">




				   <com.watutz.app.font.FirmaTextView
					   android:layout_width="wrap_content"
					   android:id="@+id/title"
					   android:layout_height="wrap_content"
					   android:layout_marginLeft="5dp"
					   android:text="@string/nameh"
					   android:textColor="@color/white"
					   android:textSize="@dimen/textsize_medium_small"
					   app:firmatypeface="firmaMedium" />

				   <com.watutz.app.font.FirmaTextView
					   android:id="@+id/date"
					   android:layout_width="wrap_content"
					   android:layout_height="wrap_content"
					   android:layout_alignParentRight="true"
					   android:layout_marginStart="5dp"
					   android:layout_marginTop="5dp"
					   android:layout_marginEnd="5dp"
					   android:layout_marginRight="5dp"
					   android:layout_marginBottom="5dp"
					   android:gravity="right"
					   android:text="@string/date"
					   android:textColor="@color/theme_color"
					   android:textSize="@dimen/textsize_small"
					   app:firmatypeface="firmaMedium" />


				   <com.watutz.app.font.FirmaTextView
					   android:layout_width="wrap_content"
					   android:id="@+id/message"
					   android:layout_height="wrap_content"
					   android:layout_marginTop="10dp"
					   android:layout_marginLeft="5dp"
					   android:layout_below="@+id/title"
					   android:maxLines="4"
					   android:text="@string/nameh"
					   android:textColor="@color/white"
					   android:textSize="@dimen/textsize_small"
					   app:firmatypeface="firmaLight" />

				   <com.watutz.app.font.FirmaTextView
					   android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
					   android:layout_below="@+id/message"
					   android:layout_alignParentRight="true"
					   android:layout_margin="5dp"
					   android:text="@string/readmore"
					   android:textColor="@color/theme_color"
					   android:textSize="@dimen/textsize_xsmall"
					   app:firmatypeface="firmaMedium"
					   android:visibility="visible" />




			   </RelativeLayout>
     
         
	  
	        </RelativeLayout>
		
		<ImageView
			android:layout_width="10dp"
			android:id="@+id/indicator"
			android:layout_alignParentRight="true"
			android:layout_centerVertical="true"
			android:background="@xml/rounded_circle_green_small"
			android:layout_height="10dp"/>
	   
          
        </RelativeLayout>
</FrameLayout>