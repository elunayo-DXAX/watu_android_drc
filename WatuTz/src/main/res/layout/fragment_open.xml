<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:background="@color/black">

        <com.watutz.app.font.FirmaTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:id="@+id/noPayments"
            android:text="@string/sorryunder"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_xlarge"
            app:firmatypeface="firmaBold" />


        <ImageView
            android:id="@+id/noPaymentsImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_below="@+id/noPayments"
            android:layout_centerInParent="true"
            android:layout_marginTop="40dp"
            app:srcCompat="@drawable/ic_hitman_codename_47" />

        <com.watutz.app.font.FirmaTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/noPaymentsImage"
            android:text="@string/checklater"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_medium_small"
            app:firmatypeface="firmaBold" />




    </RelativeLayout>

    <include layout="@layout/loading_view" />

</RelativeLayout>