<com.ogaclejapan.smarttablayout.SmartTabLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/viewpagertab"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tab_heightxx"
    android:paddingBottom="4dp"
    app:stl_distributeEvenly="true"
    app:stl_defaultTabTextColor="@color/custom_tab_selector"
    app:stl_indicatorColor="@color/theme_green"
    app:stl_indicatorCornerRadius="1.5dp"
    app:stl_indicatorInterpolation="smart"
    app:stl_dividerColor="@color/theme_hint"
    app:stl_indicatorThickness="1dp"
    app:stl_underlineColor="@color/transparent"
    app:stl_underlineThickness="1dp"

    />