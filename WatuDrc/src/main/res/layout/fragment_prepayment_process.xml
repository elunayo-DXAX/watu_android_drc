<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/topView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/backRips"
                style="@style/RippleStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_margin="10dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/icBack"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ics_back" />
                </RelativeLayout>
            </com.watudrc.app.view.MaterialRippleLayout>

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/prepayment"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:firmatypeface="firmaBold" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Card -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:background="@drawable/prepayment_gradient_bg">

                    <com.watudrc.app.font.FirmaTextView
                        android:id="@+id/headerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="start|center_vertical"
                        android:padding="10dp"
                        android:text="@string/clearing_your_loan_early"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_large"
                        android:textStyle="bold"
                        app:firmatypeface="firmaBold" />

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/ic_prepay_icons"
                        android:layout_gravity="center"/>
                </RelativeLayout>

                <!-- Step 1 Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/theme_dark_grey"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/what_is_a_prepayment"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium_small"
                            android:textStyle="bold"
                            app:firmatypeface="firmaBold" />

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/step1Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.cardview.widget.CardView>


                <!-- Step 2 Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/theme_dark_grey"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/how_much_do_i_need_to_pay"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium_small"
                            android:textStyle="bold"
                            app:firmatypeface="firmaBold" />

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/step2Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_check" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step3Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/remaining_loan_balance"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_check" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step4Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/any_unpaid_interest"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_check" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step5Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/any_overdue_charges_if_applicable"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/step6Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.cardview.widget.CardView>

                <!-- Step 3 Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/theme_dark_grey"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/how_do_i_get_my_prepayment_amount"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium_small"
                            android:textStyle="bold"
                            app:firmatypeface="firmaBold" />

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/step7Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_check" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step8Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/remaining_loan_balance"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:orientation="horizontal">

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/or"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight"
                                android:gravity="center"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_walk" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step9Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/visit_watu_branch"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />
                        </androidx.appcompat.widget.LinearLayoutCompat>



                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/step10Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/next_steps"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />



                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.cardview.widget.CardView>


                <!-- Chat Button with MaterialRippleLayout -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.watudrc.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_list_button_pay"
                        app:rippleColor="#00C6B7">

                        <RelativeLayout
                            android:id="@+id/btnChatWithUs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center">

                                <ImageView
                                    android:id="@+id/chatIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="15dp"
                                    android:gravity="center"
                                    android:src="@drawable/ics_icon_chat"
                                    app:tint="@color/white"/>

                                <com.watudrc.app.font.FirmaTextView
                                    android:layout_width="109dp"
                                    android:layout_height="48dp"
                                    android:layout_centerHorizontal="true"
                                    android:layout_toEndOf="@+id/chatIcon"
                                    android:gravity="center"
                                    android:text="@string/chat_with_us"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_medium_small"
                                    app:firmatypeface="firmaMedium" />
                            </RelativeLayout>
                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Similar Issues Section -->
                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/similar_issues"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium_small"
                    app:firmatypeface="firmaMedium" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Replacement Process Card with Ripple -->
                    <com.watudrc.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:rippleColor="#00C6B7">

                        <RelativeLayout
                            android:id="@+id/btnReplacementProcess"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:backgroundTint="@color/theme_dark_grey"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_replacement" />

                                    <com.watudrc.app.font.FirmaTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="center"
                                        android:text="@string/replacement_nprocess"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/textsize_xsmall"
                                        app:firmatypeface="firmaMedium" />
                                </androidx.appcompat.widget.LinearLayoutCompat>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>

                    <!-- Service Center Card with Ripple -->
                    <com.watudrc.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:rippleColor="#00C6B7">

                        <RelativeLayout
                            android:id="@+id/btnServiceCenter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:backgroundTint="@color/theme_dark_grey"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_service_center" />

                                    <com.watudrc.app.font.FirmaTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="center"
                                        android:text="@string/repair_nsupport"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/textsize_xsmall"
                                        app:firmatypeface="firmaMedium" />
                                </androidx.appcompat.widget.LinearLayoutCompat>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>