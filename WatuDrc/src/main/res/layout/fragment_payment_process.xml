<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".PaymentProcessesActivity">
    <!-- Header -->

    <RelativeLayout
        android:id="@+id/topView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="5dp"
            android:text="@string/makepayment"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_medium"
            app:firmatypeface="firmaBold" />


        <com.watudrc.app.view.MaterialRippleLayout
            android:id="@+id/backRips"
            style="@style/RippleStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_margin="10dp"
            app:rippleColor="@color/transparent">

            <RelativeLayout
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/icBack"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/ics_back" />
            </RelativeLayout>
        </com.watudrc.app.view.MaterialRippleLayout>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topView"
        android:background="@color/black"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <RelativeLayout
                android:id="@+id/topLayer"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center"
                android:padding="10dp">

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/iconView"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/rounded_list_button_stroke_white"
                        android:gravity="center"
                        android:padding="0dp">

                        <ImageView
                            android:id="@+id/iconImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="null"
                            android:src="@drawable/ics_pay_via"
                            android:scaleType="center"/>


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

            </RelativeLayout>

            <View
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_below="@+id/topLayer"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@color/mdtp_dark_gray" />

            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/textPaymentInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/view1"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/payment_information"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_medium_small"
                app:firmatypeface="firmaBold" />

            <!-- Grid of Payment Info -->
            <GridLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/textPaymentInfo"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:columnCount="2"
                android:orientation="horizontal"
                android:rowCount="4">

                <!-- Example grid item: Customer Name -->
                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/usernameRips"
                    style="@style/RippleStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:visibility="visible">

                    <RelativeLayout
                        android:id="@+id/btnUsername"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_black_light">

                        <ImageView
                            android:id="@+id/iconUsername"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_user_icon" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerInParent="true"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/name"
                                android:textColor="@color/theme_teal"
                                android:textSize="20sp"
                                app:firmatypeface="firmaBold" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/textUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="James Tingo"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaMedium" />

                        </LinearLayout>
                    </RelativeLayout>
                </com.watudrc.app.view.MaterialRippleLayout>

                <!-- Example grid item: Customer Name -->
                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/deviceRips"
                    style="@style/RippleStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:visibility="visible">

                    <RelativeLayout
                        android:id="@+id/btnDevice"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_black_light">

                        <LinearLayout
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerInParent="true"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/ftvDevice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/device"
                                android:textColor="@color/theme_teal"
                                android:textSize="20sp"
                                app:firmatypeface="firmaBold" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/textDevice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Samsung A06"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaMedium" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iconDevice"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ics_simu"
                            app:tint="@color/theme_orange_light" />
                    </RelativeLayout>
                </com.watudrc.app.view.MaterialRippleLayout>

                <!-- Example grid item: Customer Name -->
                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/daysRips"
                    style="@style/RippleStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:visibility="visible">

                    <RelativeLayout
                        android:id="@+id/btnDays"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_black_light">

                        <ImageView
                            android:id="@+id/iconDays"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_calender" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerInParent="true"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/days"
                                android:textColor="@color/theme_teal"
                                android:textSize="20sp"
                                app:firmatypeface="firmaBold" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/textDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/_3_days"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaMedium" />

                        </LinearLayout>
                    </RelativeLayout>
                </com.watudrc.app.view.MaterialRippleLayout>

                <!-- Example grid item: Customer Name -->
                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/amountRips"
                    style="@style/RippleStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    android:visibility="visible">

                    <RelativeLayout
                        android:id="@+id/btnAmout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/ics_monto_back">

                        <ImageView
                            android:id="@+id/iconAmount"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerInParent="true"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_coins" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerInParent="true"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/amount_c"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                app:firmatypeface="firmaBold" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/textAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="USD 139"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaMedium" />

                        </LinearLayout>
                    </RelativeLayout>
                </com.watudrc.app.view.MaterialRippleLayout>


            </GridLayout>


            <!--Payment Instructions-->

            <RelativeLayout
                android:id="@+id/payment_instructions"
                android:layout_width="450dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/grid"
                android:layout_centerInParent="true"
                android:layout_margin="10dp"
                android:background="@xml/rounded_list_black_light"
                android:padding="10dp"
                android:visibility="visible">

                <!-- Title -->
                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/make_payments"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium"
                    android:textStyle="bold"
                    app:firmatypeface="firmaBold" />

                <!-- Instructions -->
                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/tv_instructions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/titleText"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaMedium" />

                <LinearLayout
                    android:id="@+id/botView"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_below="@+id/tv_instructions"
                    android:layout_marginTop="00dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="5dp"
                        android:visibility="gone">

                        <com.watudrc.app.view.MaterialRippleLayout
                            android:id="@+id/bankPayCancelRips"
                            style="@style/RippleStyle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:rippleColor="@color/transparent">

                            <RelativeLayout
                                android:id="@+id/btnCancel"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@xml/rounded_list_button_stroke">


                                <com.watudrc.app.font.FirmaTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:text="@string/cancel"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_small"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>

                        </com.watudrc.app.view.MaterialRippleLayout>


                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:gravity="center"
                        android:padding="5dp">

                        <com.watudrc.app.view.MaterialRippleLayout
                            android:id="@+id/bankPayDoneRips"
                            style="@style/RippleStyle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:rippleColor="@color/transparent">

                            <RelativeLayout
                                android:id="@+id/btnDone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@xml/rounded_list_button">


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/acceptText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:text="@string/done"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_medium"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>

                        </com.watudrc.app.view.MaterialRippleLayout>


                    </RelativeLayout>

                </LinearLayout>

            </RelativeLayout>


        </RelativeLayout>


    </ScrollView>

</RelativeLayout>