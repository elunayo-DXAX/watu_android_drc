<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/generalContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:background="@color/black">

        <com.watudrc.app.view.UITabs
            android:id="@+id/chooseTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/tabEnglish"
                style="@style/UITabs"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:checked="true"
                android:padding="5dp"
                android:text="@string/english" />

            <RadioButton
                android:id="@+id/tabFrench"
                style="@style/UITabs"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:text="@string/french_" />


        </com.watudrc.app.view.UITabs>


        <com.watudrc.app.font.FirmaTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/termsTitle"
            android:layout_marginTop="10dp"
            android:text="@string/privacynotice"
            android:layout_below="@+id/chooseTabs"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_xlarge"
            app:firmatypeface="firmaBold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_below="@+id/termsTitle"
            android:layout_marginTop="10dp"
            android:layout_above="@+id/botView"
            android:layout_height="match_parent">

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/termsContent"
                android:text="@string/termsofservice"
                android:gravity="left"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaLight" />

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:weightSum="2"
            android:id="@+id/botView"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true"
            android:layout_height="60dp">

            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/loginRips"
                style="@style/RippleStyle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginRight="5dp"
                android:layout_height="match_parent"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnDecline"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@xml/rounded_list_button_stroke">

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/decline"
                        android:id="@+id/declineText"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_medium_small"
                        app:firmatypeface="firmaBold" />


                </RelativeLayout>

            </com.watudrc.app.view.MaterialRippleLayout>


            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/acceptRips"
                style="@style/RippleStyle"
                android:layout_width="0dp"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnAccept"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@xml/rounded_list_button">

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:id="@+id/acceptText"
                        android:text="@string/accept"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_medium_small"
                        app:firmatypeface="firmaBold" />


                </RelativeLayout>

            </com.watudrc.app.view.MaterialRippleLayout>



        </LinearLayout>







    </RelativeLayout>

    <include layout="@layout/loading_view" />

</RelativeLayout>