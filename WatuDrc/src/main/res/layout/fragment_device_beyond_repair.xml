<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:fillViewport="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/topView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp">

            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/backRips"
                style="@style/RippleStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_margin="10dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/icBack"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ics_back" />
                </RelativeLayout>
            </com.watudrc.app.view.MaterialRippleLayout>

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/service_repairs"
                android:textColor="@color/white"
                android:textSize="20sp"
                app:firmatypeface="firmaBold" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Card -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:background="@drawable/ic_service_center_background">

                    <com.watudrc.app.font.FirmaTextView
                        android:id="@+id/headerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="start|center_vertical"
                        android:padding="10dp"
                        android:text="@string/device_nbeyond_nrepair"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_xlarge"
                        android:textStyle="bold"
                        app:firmatypeface="firmaBold" />

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="170dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_repair_white" />
                </RelativeLayout>

                <!-- Step 1 Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/theme_dark_grey"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/if_your_phone_can_t_be_fixed"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium_small"
                            android:textStyle="bold"
                            app:firmatypeface="firmaBold" />

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_walk" />

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step1Text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.cardview.widget.CardView>

                <!-- Step 2 Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/theme_dark_grey"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/to_qualify_for_a_replacement_phone_you_need_to"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium_small"
                            android:textStyle="bold"
                            app:firmatypeface="firmaBold" />


                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Icon -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_check_white" />

                            <!-- Vertical stack of text lines -->
                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step2Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Icon -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_check_white" />

                            <!-- Vertical stack of text lines -->
                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step3Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Icon -->
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_check_white" />

                            <!-- Vertical stack of text lines -->
                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/step4Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaLight" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.cardview.widget.CardView>

                <!-- Chat Button with MaterialRippleLayout -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.watudrc.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_list_button_pay"
                        app:rippleColor="#00C6B7">

                        <RelativeLayout
                            android:id="@+id/btnChatWithUs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center">

                                <ImageView
                                    android:id="@+id/chatIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="15dp"
                                    android:gravity="center"
                                    android:src="@drawable/ic_chat" />

                                <com.watudrc.app.font.FirmaTextView
                                    android:layout_width="109dp"
                                    android:layout_height="48dp"
                                    android:layout_centerHorizontal="true"
                                    android:layout_toEndOf="@+id/chatIcon"
                                    android:gravity="center"
                                    android:text="@string/chat_with_us"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_medium_small"
                                    app:firmatypeface="firmaMedium" />
                            </RelativeLayout>
                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Similar Issues Section -->
                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/similar_issues"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium_small"
                    app:firmatypeface="firmaMedium" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <!-- Replacement Process Card with Ripple -->
                    <com.watudrc.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:rippleColor="#00C6B7">

                        <RelativeLayout
                            android:id="@+id/btnReplacementProcess"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="@color/theme_dark_grey"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_replacement" />

                                    <com.watudrc.app.font.FirmaTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="center"
                                        android:text="@string/replacement_nprocess"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/textsize_small"
                                        app:firmatypeface="firmaMedium" />
                                </androidx.appcompat.widget.LinearLayoutCompat>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>

                    <!-- Service Center Card with Ripple -->
                    <com.watudrc.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        app:rippleColor="#00C6B7">

                        <RelativeLayout
                            android:id="@+id/btnServiceCenter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:backgroundTint="@color/theme_dark_grey"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="16dp">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_service_center" />

                                    <com.watudrc.app.font.FirmaTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:gravity="center"
                                        android:text="@string/service_ncenter"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/textsize_small"
                                        app:firmatypeface="firmaMedium" />
                                </androidx.appcompat.widget.LinearLayoutCompat>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>