<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_container"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    android:background="@color/transparent">

    <RelativeLayout 
        android:layout_width="match_parent"
        android:layout_centerInParent="true"
        android:background="@xml/rounded_list_white_bottom_none_small"
        android:layout_height="250dp">

		<RelativeLayout
			android:layout_width="match_parent"
			android:id="@+id/header"
			android:layout_height="50dp">

		  <com.watudrc.app.view.MaterialRippleLayout
			android:id="@+id/backRips"
			style="@style/RippleStyle"
			android:layout_width="50dp"
			android:layout_height="50dp"
			app:rippleColor="@color/transparent" >

			<RelativeLayout
				android:id="@+id/btnBack"
				android:layout_width="match_parent"
				android:padding="10dp"
				android:layout_height="match_parent" >

				<ImageView
					android:layout_width="20dp"
					app:srcCompat="@drawable/ics_back"
					android:layout_centerInParent="true"
					android:layout_height="20dp"/>

			</RelativeLayout>
		</com.watudrc.app.view.MaterialRippleLayout>


		<com.watudrc.app.font.FirmaTextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/paymentmethod"
			android:layout_centerInParent="true"
			app:firmatypeface="firmaBold"
			android:textColor="@color/theme_color"
			android:textSize="@dimen/textsize_medium"/>

			<ImageView
				android:layout_width="match_parent"
				android:background="@color/theme_blue_light"
				android:layout_alignParentBottom="true"
				android:layout_height="1dp"/>

		</RelativeLayout>

		<RelativeLayout
			android:layout_width="match_parent"
			android:id="@+id/botView"
			android:layout_below="@+id/header"
			android:padding="20dp"
			android:layout_height="wrap_content">

			<RelativeLayout
				android:layout_width="match_parent"
				android:background="@xml/rounded_list_transparent_green_stroke"
				android:id="@+id/btnMpesa"
				android:padding="10dp"
				android:layout_height="60dp">

				<CheckBox
					android:id="@+id/chkMpesa"
					android:layout_width="20dp"
					android:layout_height="20dp"
					android:checked="true"
					android:layout_centerVertical="true"
					android:button="@drawable/custom_checkbox" />

				<com.watudrc.app.font.FirmaTextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="@string/mpesah"
					android:layout_below="@+id/phone"
					android:layout_toRightOf="@+id/chkMpesa"
					android:layout_marginTop="10dp"
					android:layout_centerVertical="true"
					android:layout_marginLeft="10dp"
					app:firmatypeface="firmaMedium"
					android:textColor="@color/theme_color"
					android:textSize="@dimen/textsize_xsmall"/>

				<RelativeLayout
					android:layout_width="wrap_content"
					android:background="@xml/rounded_list_transparent_blue_stroke"
					android:layout_centerVertical="true"
					android:layout_alignParentRight="true"
					android:padding="10dp"
					android:layout_height="wrap_content">

					<ImageView
						android:layout_width="50dp"
						app:srcCompat="@drawable/ics_mpesa"
						android:layout_height="20dp"/>


				</RelativeLayout>





			</RelativeLayout>





		</RelativeLayout>

		<com.watudrc.app.view.MaterialRippleLayout
            style="@style/RippleStyle"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_margin="20dp"
			android:layout_below="@+id/botView"
			android:layout_centerHorizontal="true"
			android:layout_marginTop="30dp"
			app:rippleColor="@color/transparent">

			<RelativeLayout
				android:id="@+id/btnContinue"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@xml/rounded_list_button">

				<com.watudrc.app.font.FirmaTextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_below="@+id/fow"
					android:layout_centerInParent="true"
					android:text="@string/continueh"
					android:textColor="@color/white"
					android:textSize="@dimen/textsize_medium_small"
					app:firmatypeface="firmaMedium" />


			</RelativeLayout>

		</com.watudrc.app.view.MaterialRippleLayout>

		<include layout="@layout/loading_view_dialog" />
   
          
      </RelativeLayout>
      
      
    

 </RelativeLayout>