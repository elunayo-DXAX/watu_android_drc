<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/generalContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:background="@color/black">

        <ImageView
            android:layout_width="match_parent"
            android:src="@drawable/ic_logo"
            android:layout_marginTop="20dp"
            android:id="@+id/icLogo"
            android:layout_centerHorizontal="true"
            android:layout_height="100dp"/>

        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/languageH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/languagelugha"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_small"
            app:firmatypeface="firmaBold" />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:weightSum="2"
            android:layout_marginTop="30dp"
            android:layout_below="@+id/languageH"
            android:id="@+id/botView"
            android:orientation="horizontal"
            >
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="match_parent">

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:id="@+id/acceptRips"
                    android:layout_height="match_parent"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:id="@+id/btnFrench"
                        android:background="@xml/rounded_list_button_white_stroke"
                        android:layout_height="match_parent">


                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/acceptText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/french_"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>




            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="match_parent">



                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:id="@+id/englishRips"
                    android:layout_height="match_parent"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:id="@+id/btnEnglish"
                        android:background="@xml/rounded_list_button"
                        android:layout_height="match_parent">


                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/english"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>






            </RelativeLayout>

        </LinearLayout>

    </RelativeLayout>





</RelativeLayout>