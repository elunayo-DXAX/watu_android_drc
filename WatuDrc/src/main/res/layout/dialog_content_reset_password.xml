<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_container"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    >
   
   
    <RelativeLayout
        android:layout_width="300dp"
        android:layout_centerInParent="true"
        android:background="@color/transparent"
        android:layout_height="350dp">
        
        
       <RelativeLayout 
        android:layout_width="match_parent"
           android:background="@xml/rounded_list_white_small"
        android:layout_height="match_parent">
        
           
           <RelativeLayout
               
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/title"
                android:background="@xml/rounded_list_white_bottom_none_small"
                android:minHeight="50dp">
                
               
		         <com.watudrc.app.font.FirmaTextView
		            android:layout_width="wrap_content"
		            android:layout_height="wrap_content"
		            android:text="@string/resetpassword"
		            android:layout_centerInParent="true"
		            app:firmatypeface="firmaLight"
		            android:textColor="@color/white"
		            android:textSize="@dimen/textsize_medium"/>
               
           </RelativeLayout>
           
            <ImageView
			         android:id="@+id/gifImage"
			         android:layout_height="120dp"
			         android:layout_width="120dp" 
			         android:layout_margin="5dp"
			         android:layout_below="@+id/title"
			         android:layout_centerHorizontal="true"
			         
			        />
            
            
    
            
             <RelativeLayout 
                           android:layout_width="match_parent"
                           android:background="@color/white"
                           android:id="@+id/editView"
                           android:layout_marginLeft="10dp"
                           android:layout_marginRight="10dp"
                           android:layout_below="@+id/gifImage"
                           android:layout_height="60dp">
                           
                           <com.watudrc.app.view.FloatLabeledEditText
				            android:id="@+id/emailEditText"
				            android:layout_width="match_parent"
				            android:layout_height="60dp"
				            android:minHeight="60dp"
				            android:textColorHint="@color/theme_grey"
				            app:fletFloatingHint="@string/enteremail"
				            app:fletHintTextColor="@color/theme_grey"
				            app:fletSingleLine="true"
				            app:fletImeOptions="actionDone"
				            app:fletTextGravity="center"
				            app:fletInputType="text"
				            app:fletTextColor="@color/black" />
		                     
					            
					        
                       </RelativeLayout>
            
            
            
              <LinearLayout 
							android:layout_width="match_parent"
							android:layout_height="80dp"
							android:weightSum="2"
							android:layout_alignParentBottom="true"
							android:id="@+id/botView"
							android:orientation="horizontal"
							>
	                     <RelativeLayout
				             android:layout_width="0dp"
				             android:layout_weight="1" 
				             android:gravity="center"
				             android:layout_height="match_parent">
				             
	              <com.watudrc.app.view.MaterialRippleLayout
				        style="@style/RippleStyle"
				        android:layout_width="match_parent"
                      android:layout_height="match_parent"
				        app:rippleColor="@color/transparent"
				        app:rippleInAdapter="false">
		     
		     <RelativeLayout 
		        android:layout_width="match_parent" 
		        android:id="@+id/btnCancel"
		        android:background="@xml/rounded_list_theme_red_left_corner"
		        android:layout_height="match_parent">
		        
		       
		         <com.watudrc.app.font.FirmaTextView
							            android:layout_width="wrap_content"
							            android:layout_height="wrap_content"
							            android:text="@string/cancel"
							            android:layout_below="@+id/fow"
							            android:textAllCaps="true"
							            android:layout_centerInParent="true"
							            app:firmatypeface="firmaLight"
							            android:textColor="@color/white"
							            android:textSize="@dimen/textsize_medium"/>
		
		          
		         </RelativeLayout>
             
		     </com.watudrc.app.view.MaterialRippleLayout>
				             
	                      </RelativeLayout>
	                      
	                      <RelativeLayout
				             android:layout_width="0dp"
				             android:layout_weight="1" 
				             android:gravity="center"
				             android:layout_height="match_parent">
	              
	              <com.watudrc.app.view.MaterialRippleLayout
				        style="@style/RippleStyle"
				        android:layout_width="match_parent"
                      android:layout_height="match_parent"
				        app:rippleInAdapter="false"
				        app:rippleColor="@color/transparent">
		     
						     <RelativeLayout 
						        android:layout_width="match_parent" 
						        android:id="@+id/btnConfirm"
						        android:background="@xml/rounded_list_theme_green_right_corner"
						        android:layout_height="match_parent">
						        
						       
						         <com.watudrc.app.font.FirmaTextView
											            android:layout_width="wrap_content"
											            android:layout_height="wrap_content"
											            android:text="@string/reset"
											            android:layout_below="@+id/fow"
											            android:textAllCaps="true"
											            android:layout_centerInParent="true"
											            app:firmatypeface="firmaLight"
											            android:textColor="@color/white"
											            android:textSize="@dimen/textsize_medium"/>
						
						          
						         </RelativeLayout>
             
		     </com.watudrc.app.view.MaterialRippleLayout>
				             
	                      </RelativeLayout>
	                      
	           </LinearLayout>
              
        
        </RelativeLayout>
        
       
       
           
     <include layout="@layout/loading_view_dialog" />
   
          
      </RelativeLayout>
      
      
    

 </RelativeLayout>