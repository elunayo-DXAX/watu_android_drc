<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@color/black">



        <RelativeLayout
            android:layout_width="100dp"
            android:id="@+id/seekBarView"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">


            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:progress="3"
                android:padding="0dp"
                android:paddingEnd="0dp"
                android:paddingStart="0dp"
                android:max="3"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@color/transparent"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true">
            </SeekBar>

        </RelativeLayout>



        <RelativeLayout
            android:id="@+id/topView"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/seekBarView"
            android:layout_height="wrap_content">

            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:text="@string/confirmyourfingeprint"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_large"
                app:firmatypeface="firmaBold"

                />

            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:text="@string/enabletouchid"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_medium_small"
                app:firmatypeface="firmaMedium"

                />


        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/midContent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="match_parent"
            android:layout_below="@id/topView">



            <!-- Fingerprint Icon -->
            <ImageView
                android:id="@+id/fingerprintIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:src="@drawable/ics_icon_fingerprint"
               />

            <ImageView
                android:id="@+id/fingerprintIconFilled"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="60dp"
                android:src="@drawable/ics_icon_fingerprint"
                android:tint="@color/theme_green"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/fingerprintIconError"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="60dp"
                android:src="@drawable/ics_icon_fingerprint"
                android:tint="@color/theme_red"
                android:visibility="gone" />

            <!-- Instruction Text -->
            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/txtInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeyourfingerprint"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_small"
                android:gravity="center"
                app:firmatypeface="firmaMedium"
                android:layout_below="@id/fingerprintIcon"
                android:layout_marginTop="20dp"
                android:layout_centerHorizontal="true" />

            <!-- Confirm Button -->
            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/confirmRips"
                style="@style/RippleStyle"
                android:layout_width="300dp"
                android:layout_height="47dp"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/txtInstruction"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="30dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@xml/rounded_list_button_teal">

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/setfingerprint"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_medium_small"
                        app:firmatypeface="firmaBold" />
                </RelativeLayout>
            </com.watudrc.app.view.MaterialRippleLayout>

            <!-- Cancel Button -->
            <com.watudrc.app.view.MaterialRippleLayout
                style="@style/RippleStyle"
                android:layout_width="300dp"
                android:layout_height="47dp"
                android:layout_below="@+id/confirmRips"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="30dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnSkip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@xml/rounded_list_transparent_theme_stroke">

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/skip"
                        android:textColor="@color/theme_color"
                        android:textSize="@dimen/textsize_medium"
                        app:firmatypeface="firmaBold" />
                </RelativeLayout>
            </com.watudrc.app.view.MaterialRippleLayout>
        </LinearLayout>

        <include layout="@layout/loading_view" />

    </RelativeLayout>

</RelativeLayout>


