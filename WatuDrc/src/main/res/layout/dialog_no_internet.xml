<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/support_hub_dialog_bg"
    android:padding="15dp"
    android:layout_gravity="center">

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_close"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:layout_gravity="end"/>


    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:background="@drawable/circular_theme_icon_bg"
        android:gravity="center">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_phone_sms"
            app:tint="@color/white" />

    </LinearLayout>

    <com.watudrc.app.font.FirmaTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/contact_us"
        android:textColor="@color/black"
        android:textSize="@dimen/textsize_medium_large"
        app:firmatypeface="firmaBold" />


    <com.watudrc.app.view.MaterialRippleLayout
        android:id="@+id/chatRips"
        style="@style/RippleStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:rippleColor="@color/transparent">

        <RelativeLayout
            android:id="@+id/chat_with_cc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@xml/rounded_list_button">

            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/textFastOption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/fastest_option"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="0dp"
                android:layout_marginEnd="5dp"
                app:firmatypeface="firmaBold"
                android:textSize="10sp"
                android:background="@drawable/text_fast_option_bg"/>

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/continue_with_live_chat"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaBold"
                android:drawableStart="@drawable/ics_icon_chat"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:layout_below="@id/textFastOption"
                android:layout_marginBottom="14dp"/>


        </RelativeLayout>

    </com.watudrc.app.view.MaterialRippleLayout>

    <com.watudrc.app.view.MaterialRippleLayout
        android:id="@+id/callRips"
        style="@style/RippleStyle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        app:rippleColor="@color/transparent">

    <RelativeLayout
        android:id="@+id/call_cc"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/payOtherH"
        android:background="@xml/rounded_list_transparent_black_stroke"
        android:gravity="center_vertical">

        <com.watudrc.app.font.FirmaTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:hint="@string/call_customer_care"
            android:textColor="@color/black"
            android:textSize="@dimen/textsize_small"
            app:firmatypeface="firmaBold"
            android:drawableStart="@drawable/ic_call"
            android:drawablePadding="8dp"
            android:drawableTint="@color/black"/>

    </RelativeLayout>
    </com.watudrc.app.view.MaterialRippleLayout>

    <com.watudrc.app.font.FirmaTextView
        android:id="@+id/tv_copy_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_0700_000_000"
        android:textColor="@color/black"
        android:textSize="@dimen/textsize_medium_small"
        app:firmatypeface="firmaLight"
        android:drawableStart="@drawable/ic_copy"
        android:drawablePadding="8dp"
        android:drawableTint="@color/black"
        android:layout_marginTop="16dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

</LinearLayout>