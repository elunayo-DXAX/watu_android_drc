<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="-10dp"
    android:background="@color/black">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <!-- Top Bar -->
            <RelativeLayout
                android:id="@+id/topView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp">

                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/settings"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium_large"
                    app:firmatypeface="firmaBold" />

                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/backRips"
                    style="@style/RippleStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_margin="10dp"
                    android:visibility="gone"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnBack"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/icBack"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            app:srcCompat="@drawable/ics_back" />
                    </RelativeLayout>
                </com.watudrc.app.view.MaterialRippleLayout>
            </RelativeLayout>

            <!-- Profile Card -->
            <RelativeLayout
                android:id="@+id/profileView"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_below="@+id/topView"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/ic_drawer_back"
                android:padding="15dp">

                <RelativeLayout
                    android:id="@+id/top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:src="@drawable/ic_logo"
                        android:visibility="gone"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/iconImage"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/ics_profile_pic"
                        app:tint="@color/white" />

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/iconImage">

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/userName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/name"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_small"
                                app:firmatypeface="firmaMedium" />


                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/userName"
                                android:layout_marginTop="5dp">


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/userNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/phonenumber"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_small"
                                    app:firmatypeface="firmaMedium" />


                            </RelativeLayout>

                        </RelativeLayout>

                    </RelativeLayout>

                </RelativeLayout>

            </RelativeLayout>

            <!-- GENERAL SETTINGS Section -->
            <RelativeLayout
                android:id="@+id/generalSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/profileView"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp">

                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/generalsettings"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_xsmall"
                    android:textStyle="bold" />

            </RelativeLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/generalSettingsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/generalSettings"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@xml/rounded_list_grey_dark"
                android:orientation="vertical"
                android:padding="4dp">

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/languageIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_language_icon"
                            app:tint="@color/white" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/languageIcon"
                            android:text="@string/language"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />

                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/transparent" />

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/notificationIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_notification_bell_empty" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/notificationIcon"
                            android:text="@string/notifications"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />
                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/transparent" />

                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/documentRips"
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnDocuments"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/downloadsIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_icon_documents" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/downloadsIcon"
                            android:text="@string/documents"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />
                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/transparent" />

                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/upgradeRips"
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnUpgrade"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/levelupIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_icon_upgrade" />

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/upgradeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/levelupIcon"
                            android:text="@string/upgrade"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />

                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:visibility="gone"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnFingeprint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:clickable="false">

                        <ImageView
                            android:id="@+id/biometricIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_icon_fingerprint"
                            app:tint="@color/white" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/biometricIcon"
                            android:text="@string/biometricauthentication"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchFingerprint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:checked="false" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/permissionIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_toggle_permissions"
                            app:tint="@color/white" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/permissionIcon"
                            android:text="@string/permissions"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />

                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- MORE Section -->
            <RelativeLayout
                android:id="@+id/moreSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/generalSettingsView"
                android:layout_marginStart="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp">

                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/more"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_xsmall"
                    android:textStyle="bold" />
            </RelativeLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/moreSettingsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/moreSettings"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@xml/rounded_list_grey_dark"
                android:orientation="vertical"
                android:padding="4dp">

                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/aboutRips"
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnAboutUs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/aboutIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_profile_empty" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/aboutIcon"
                            android:text="@string/aboutus"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />

                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/transparent" />


                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnResources"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/resourceIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_icon_help_empty"
                            app:tint="@color/white" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/resourceIcon"
                            android:text="@string/resourcecenter"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />
                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/transparent" />

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent"
                    android:visibility="gone">

                    <RelativeLayout
                        android:id="@+id/btnHelpAndSupport"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/faqIcon"
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_icon_bubble" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/faqIcon"
                            android:text="@string/faqsupport"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />
                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/transparent" />

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnChat"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/chatIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_contact_us"
                            app:tint="@color/white" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/chatIcon"
                            android:text="@string/contact_us"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_next_icon" />
                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Logout Button -->
            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/logoutRips"
                style="@style/RippleStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_below="@+id/moreSettingsView"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="35dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@xml/rounded_list_transparent_white_stroke"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/logoutIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ics_logout_empty" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="12dp"
                            android:layout_toEndOf="@+id/logoutIcon"
                            android:text="@string/logout"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold" />

                    </RelativeLayout>
                </RelativeLayout>
            </com.watudrc.app.view.MaterialRippleLayout>

            <!-- Version Text -->
            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/logoutRips"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/app_version"
                android:textColor="@color/theme_green"
                android:textSize="@dimen/textsize_xsmall"
                app:firmatypeface="firmaMedium" />

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>