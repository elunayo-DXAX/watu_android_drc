<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/support_hub_dialog_bg"
    android:orientation="vertical"
    android:padding="15dp">

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:src="@drawable/ic_close" />


    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:background="@drawable/circular_theme_icon_bg"
        android:gravity="center">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_call"
            app:tint="@color/white" />

    </LinearLayout>

    <com.watudrc.app.font.FirmaTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:text="@string/enable_calling_for_help"
        android:textColor="@color/black"
        android:textSize="@dimen/textsize_medium_large"
        app:firmatypeface="firmaBold" />

    <com.watudrc.app.font.FirmaTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawableStart="@drawable/ic_phone_lock2"
        android:drawablePadding="8dp"
        android:drawableTint="@color/theme_teal"
        android:gravity="center"
        android:text="@string/your_privacy_is_protected"
        android:textColor="@color/black"
        android:textSize="@dimen/textsize_xsmall"
        app:firmatypeface="firmaBold" />

    <com.watudrc.app.font.FirmaTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="@string/we_don_t_access_your_call_history_or_contacts"
        android:textColor="@color/black"
        android:textSize="@dimen/textsize_xsmall"
        app:firmatypeface="firmaBold" />

    <com.watudrc.app.view.MaterialRippleLayout
        android:id="@+id/enableCallRips"
        style="@style/RippleStyle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        app:rippleColor="@color/transparent">

        <RelativeLayout
            android:id="@+id/enable_call_permissions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@xml/rounded_list_button">

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:drawableStart="@drawable/ic_call"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:text="@string/enable_calling"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaBold" />

        </RelativeLayout>

    </com.watudrc.app.view.MaterialRippleLayout>

    <com.watudrc.app.font.FirmaTextView
        android:id="@+id/tvLiveChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/live_chat_works_without_this_permission"
        android:textColor="@color/black"
        android:textSize="@dimen/textsize_small"
        app:firmatypeface="firmaLight" />

    <com.watudrc.app.view.MaterialRippleLayout
        android:id="@+id/chatRips"
        style="@style/RippleStyle"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="20dp"
        app:rippleColor="@color/transparent">

        <RelativeLayout
            android:id="@+id/chat_with_cc"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/payOtherH"
            android:background="@xml/rounded_list_transparent_black_stroke"
            android:gravity="center_vertical">

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:drawableStart="@drawable/ics_icon_chat"
                android:drawablePadding="8dp"
                android:drawableTint="@color/black"
                android:text="@string/continue_with_live_chat"
                android:textColor="@color/black"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaBold" />

        </RelativeLayout>
    </com.watudrc.app.view.MaterialRippleLayout>

</LinearLayout>