<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/loanCompleteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:background="@color/black">

        <com.watudrc.app.font.FirmaTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/congratsText"
            android:text="@string/congrats"
            android:layout_centerHorizontal="true"
            android:textColor="@color/theme_green"
            android:textAllCaps="true"
            android:textSize="@dimen/textsize_xxlarge"
            app:firmatypeface="firmaBold" />


        <ImageView
            android:id="@+id/icCongrats"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@+id/congratsText"
            android:layout_centerInParent="true"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/ics_congrats" />

        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/happyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/icCongrats"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/wearehappy"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_medium_small"
            app:firmatypeface="firmaBold" />

        <com.watudrc.app.view.MaterialRippleLayout
            android:id="@+id/doneRips"
            style="@style/RippleStyle"
            android:layout_width="250dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/happyText"
            android:layout_marginTop="20dp"
            app:rippleColor="@color/transparent">

            <RelativeLayout
                android:id="@+id/btnHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@xml/rounded_list_button_green">

                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/gobackhome"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium_small"
                    app:firmatypeface="firmaBold" />


            </RelativeLayout>

        </com.watudrc.app.view.MaterialRippleLayout>


        <ImageView
            android:id="@+id/adCard"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@+id/doneRips"
            android:layout_centerInParent="true"
            android:layout_marginTop="20dp"
            app:srcCompat="@drawable/ic_loan_done" />





    </RelativeLayout>

    <include layout="@layout/loading_view" />

</RelativeLayout>