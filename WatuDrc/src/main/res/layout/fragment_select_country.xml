<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <ImageView
            android:layout_width="match_parent"
            android:src="@drawable/ic_preview_3"
            android:scaleType="fitXY"
            android:layout_height="match_parent"/>





        <LinearLayout
            android:layout_width="match_parent"
            android:weightSum="100"
            android:orientation="vertical"
            android:layout_height="match_parent">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_weight="48"
                android:layout_height="0dp">

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_weight="52"
                android:background="@xml/rounded_list_white_small"
                android:padding="10dp"
                android:layout_height="0dp">

                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/countryH"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/selectyourcountrytocontinue"
                    android:textColor="@color/theme_color"
                    android:textSize="@dimen/textsize_large"
                    app:firmatypeface="firmaBold" />

                <ListView
                    android:layout_width="match_parent"
                    android:id="@+id/listView"
                    android:divider="@color/transparent"
                    android:dividerHeight="1dp"
                    android:layout_marginTop="15dp"
                    android:layout_below="@+id/countryH"
                    android:layout_above="@+id/nextRips"
                    android:layout_height="match_parent"/>


                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/nextRips"
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_margin="18dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnContinue"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_button">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/continueh"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_medium_small"
                            app:firmatypeface="firmaMedium" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>



            </RelativeLayout>

        </LinearLayout>





    </RelativeLayout>

    <include layout="@layout/loading_view" />

</RelativeLayout>