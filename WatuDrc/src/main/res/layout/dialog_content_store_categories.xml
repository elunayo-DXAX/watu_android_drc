        android:id="@+id/backView"
        android:background="@color/black"
        android:layout_height="@dimen/tab_heightx" >

        <com.watudrc.app.view.MaterialRippleLayout
            android:id="@+id/backRips"
            style="@style/RippleStyle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerVertical="true"
            app:rippleColor="@color/transparent" >

            <RelativeLayout
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:padding="10dp"
                android:layout_height="match_parent" >

                <ImageView
                    android:layout_width="20dp"
                    app:srcCompat="@drawable/ics_back"
                    android:layout_centerInParent="true"
                    android:layout_height="20dp"/>

            </RelativeLayout>
        </com.watudrc.app.view.MaterialRippleLayout>

        <com.watudrc.app.font.FirmaTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:text="@string/makepayment"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_medium_large"
            app:firmatypeface="firmaMedium" />

    </RelativeLayout>


