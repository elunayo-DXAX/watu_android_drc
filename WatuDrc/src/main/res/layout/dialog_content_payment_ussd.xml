<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_container"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    android:background="@color/black"

    >





	<RelativeLayout
        android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_centerInParent="true"
		android:background="@color/black"
		android:padding="20dp">



		<RelativeLayout
			android:layout_width="wrap_content"
            android:layout_above="@+id/submitRips"
			android:layout_height="wrap_content">


			<com.watudrc.app.view.MaterialRippleLayout
				android:id="@+id/backRips"
				style="@style/RippleStyle"
				android:layout_width="wrap_content"
				android:layout_margin="10dp"
				android:layout_alignParentRight="true"
				android:layout_height="wrap_content"
				app:rippleColor="@color/transparent" >

				<RelativeLayout
					android:id="@+id/btnBack"
					android:layout_width="wrap_content"
					android:padding="10dp"
					android:layout_height="50dp" >

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:id="@+id/icBack"
						android:layout_centerVertical="true"
						app:srcCompat="@drawable/ics_back" />

					<com.watudrc.app.font.FirmaTextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="5dp"
						android:layout_toRightOf="@+id/icBack"
						android:layout_centerVertical="true"
						android:text="@string/back"
						android:textColor="@color/theme_color"
						android:textSize="@dimen/textsize_medium"
						app:firmatypeface="firmaMedium" />


				</RelativeLayout>
			</com.watudrc.app.view.MaterialRippleLayout>


			<RelativeLayout
				android:id="@+id/iconView"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_below="@+id/backRips"
				android:layout_centerHorizontal="true"
				android:layout_marginStart="15dp"
				android:layout_marginTop="15dp"
				android:layout_marginEnd="15dp"
				android:layout_marginBottom="15dp"
				android:background="@xml/rounded_list_transparent_orange_light_stroke"
				android:padding="10dp">

				<ImageView
					android:id="@+id/payIcon"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_centerHorizontal="true"
					android:src="@drawable/ics_rect_mpesa" />

			</RelativeLayout>



			<com.watudrc.app.font.FirmaTextView
				android:id="@+id/paymentH"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:layout_below="@+id/iconView"
				android:text="@string/makepayments"
				android:textColor="@color/white"
				android:textSize="@dimen/textsize_xlarge"
				app:firmatypeface="firmaBold" />

			<com.watudrc.app.font.FirmaTextView
				android:id="@+id/paymentTitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:layout_below="@+id/paymentH"
				android:text="@string/howtopayviampesa"
				android:textColor="@color/theme_green"
				android:textSize="@dimen/textsize_large"
				app:firmatypeface="firmaBold" />

			<ScrollView
				android:layout_width="match_parent"
				android:fillViewport="true"
				android:layout_marginTop="30dp"
				android:layout_below="@+id/paymentTitle"
				android:layout_height="match_parent">

			<com.watudrc.app.font.FirmaTextView
				android:id="@+id/paymentText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"

				android:text="@string/paympesa"
				android:textColor="@color/white"
				android:textSize="@dimen/textsize_medium"
				app:firmatypeface="firmaMedium" />

			</ScrollView>


		</RelativeLayout>




		<com.watudrc.app.view.MaterialRippleLayout
			android:id="@+id/submitRips"
			style="@style/RippleStyle"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_alignParentBottom="true"
			android:layout_marginTop="50dp"
			app:rippleColor="@color/transparent">

			<RelativeLayout
				android:id="@+id/btnSubmit"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@xml/rounded_list_button">

				<com.watudrc.app.font.FirmaTextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_centerInParent="true"
					android:text="@string/pay"
					android:textColor="@color/white"
					android:textSize="@dimen/textsize_medium_small"
					app:firmatypeface="firmaBold" />


			</RelativeLayout>

		</com.watudrc.app.view.MaterialRippleLayout>






		<include layout="@layout/loading_view_dialog" />



	</RelativeLayout>


 </RelativeLayout>