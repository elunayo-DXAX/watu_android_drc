<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_margin="10dp"
            android:id="@+id/topView"
            android:layout_height="wrap_content">

            <!-- Download Button -->
            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_toLeftOf="@+id/btnShare"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                android:background="@xml/rounded_circle_transparent_black_light"
                android:contentDescription="Download PDF"
                android:src="@drawable/ics_icon_download_nose" />

            <!-- Share Button -->
            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:src="@android:drawable/ic_menu_share"
                app:tint="@color/white"
                android:background="@xml/rounded_circle_transparent_black_light"
                android:contentDescription="Share PDF" />


        </RelativeLayout>


        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_below="@+id/topView"
            android:layout_height="match_parent" />






    </RelativeLayout>

    <include layout="@layout/loading_view" />

</RelativeLayout>