<!--                                android:textSize="15sp"-->
<!--                                app:firmatypeface="firmaMedium" />-->
<!--                        </RelativeLayout>-->
<!--                    </com.watudrc.app.view.MaterialRippleLayout>-->

                    <!-- Common App Issues  -->
                    <com.watudrc.app.view.MaterialRippleLayout
                        android:id="@+id/commonAppIssuesRips"
                        style="@style/RippleStyle"
                        android:layout_width="0dp"
                        android:layout_height="120dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="2"
                        android:layout_margin="8dp">

                        <RelativeLayout
                            android:id="@+id/btnCommonIssues"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@xml/rounded_list_black_light">

                            <ImageView
                                android:id="@+id/iconCommonIssues"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="20dp"
                                android:src="@drawable/ic_common_issues" />

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/iconCommonIssues"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:text="@string/commonappissues"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                app:firmatypeface="firmaMedium" />
                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>

                </GridLayout>

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/grid_2"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="30dp"
                    app:rippleColor="#00C6B7">

                    <RelativeLayout
                        android:id="@+id/btnChatWithUs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/chatIcon"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:src="@drawable/ics_icon_chat"
                            app:tint="@color/theme_green" />

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/ftv_chat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/chatIcon"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/live_chat_with_us"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ftv_chat"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="3dp"
                            android:gravity="center"
                            android:text="@string/watu_live_chat"
                            android:textColor="@color/theme_teal"
                            android:textSize="@dimen/textsize_xsmall"
                            app:firmatypeface="firmaMedium" />

                    </RelativeLayout>
                </com.watudrc.app.view.MaterialRippleLayout>

            </RelativeLayout>

            <!-- this is where we’ll load child fragments -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </RelativeLayout>

    </ScrollView>


</RelativeLayout> 