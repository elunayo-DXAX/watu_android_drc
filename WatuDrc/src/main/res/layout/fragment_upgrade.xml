<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:padding="20dp">

            <RelativeLayout
                android:id="@+id/topView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/icUpgrade"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:tint="@color/white"
                    app:srcCompat="@drawable/ics_icon_chart" />


                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="10dp"
                    android:layout_toRightOf="@+id/icUpgrade"
                    android:text="@string/upgradeyourdevice"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium_small"
                    app:firmatypeface="firmaBold" />


            </RelativeLayout>


            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/readyH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/topView"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:text="@string/getbiggerstorage"
                android:textColor="@color/theme_orange_light"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaMedium" />

            <RelativeLayout
                android:id="@+id/highlightView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/readyH"
                android:layout_marginTop="10dp"
                android:background="@xml/rounded_list_darker_blue"
                android:padding="5dp">

                <LinearLayout
                    android:id="@+id/seekView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="@string/paymentprogress"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold" />

                        <ImageView
                            android:id="@+id/iconPadlock"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            app:srcCompat="@drawable/ics_icon_lock" />

                    </RelativeLayout>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/progressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignStart="@id/seekBar"
                            android:layout_marginTop="5dp"
                            android:background="@xml/rounded_list_theme"
                            android:paddingHorizontal="10dp"
                            android:text="0%"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_xsmall"
                            app:firmatypeface="firmaBold" />

                        <SeekBar
                            android:id="@+id/seekBar"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_below="@id/progressText"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="20"
                            android:progressDrawable="@drawable/seek_progress_theme"
                            android:thumb="@color/transparent" />

                    </RelativeLayout>


                    <com.watudrc.app.font.FirmaTextView
                        android:id="@+id/progressAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/youarejustfromupgrade"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />


                    <com.watudrc.app.view.MaterialRippleLayout
                        android:id="@+id/payNowRips"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:layout_below="@id/descText"
                        android:layout_gravity="right"
                        android:background="@xml/rounded_list_button"
                        app:rippleColor="@color/theme_color">

                        <RelativeLayout
                            android:id="@+id/btnPayNow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="5dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:gravity="center"
                                android:text="@string/paynow"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_xsmall"
                                app:firmatypeface="firmaBold" />

                        </RelativeLayout>
                    </com.watudrc.app.view.MaterialRippleLayout>

                </LinearLayout>


            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/optionsContent"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_below="@+id/highlightView"
                android:layout_marginTop="5dp"
                android:background="@xml/rounded_list_darker_blue"
                android:padding="5dp"
                android:visibility="gone">

                <RelativeLayout
                    android:id="@+id/topOptionsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="5dp"
                        android:background="@xml/rounded_list_transparent_white_faint_stroke"
                        android:padding="15dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:tint="@color/white"
                            app:srcCompat="@drawable/ics_icon_chart" />


                    </RelativeLayout>


                    <com.watudrc.app.font.FirmaTextView
                        android:id="@+id/upgradeOptionsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:text="@string/yourupgradeoptions"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_medium_small"
                        app:firmatypeface="firmaBold" />


                </RelativeLayout>

                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/unlockLongerH"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/topOptionsView"
                    android:layout_marginTop="10dp"
                    android:text="@string/unlocklonger"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_xsmall"
                    app:firmatypeface="firmaMedium" />

                <HorizontalScrollView
                    android:id="@+id/optionsHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/unlockLongerH"
                    android:layout_marginTop="10dp">


                    <LinearLayout
                        android:id="@+id/optionsView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                    </LinearLayout>

                </HorizontalScrollView>


                <ImageView
                    android:id="@+id/sliderIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/optionsHorizontal"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="5dp"
                    app:srcCompat="@drawable/ics_slider_icons" />

                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/sliderIndicator"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/swipetosee"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_xsmall"
                    app:firmatypeface="firmaMedium" />


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/devicesContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/highlightView"
                android:layout_marginTop="5dp"
                android:visibility="gone">


                <LinearLayout
                    android:id="@+id/comparisonView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@xml/rounded_list_darker_blue"

                    android:orientation="vertical"
                    android:weightSum="2">


                    <RelativeLayout
                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"
                        android:layout_below="@+id/readyH"
                        android:layout_marginTop="5dp">


                        <ImageView
                            android:id="@+id/deviceImage"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            app:srcCompat="@drawable/ics_icon_device" />


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/deviceImage"
                            android:orientation="vertical"
                            android:padding="5dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/currentdevice"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_medium_small"
                                app:firmatypeface="firmaBold" />


                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/deviceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/name"
                                android:textColor="@color/theme_color"
                                android:textSize="@dimen/textsize_xsmall"
                                app:firmatypeface="firmaBold" />


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icSpecBattery"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_battery" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/deviceBattery"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icSpecBattery"
                                    android:text="@string/longerbatterylife"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icSpecCamera"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_camera" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/deviceCamera"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icSpecCamera"
                                    android:text="@string/bettercamera"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icSpecRom"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_ram" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/deviceRom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icSpecRom"
                                    android:text="@string/increasedstoragecapacity"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icRom"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_rom" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/deviceDisplay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icRom"
                                    android:text="@string/fasterprocessing"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <!--  End of Upgrade Layout-->


                        </LinearLayout>


                    </RelativeLayout>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/readyH"
                        android:layout_marginTop="5dp"
                        android:padding="5dp">


                        <RelativeLayout
                            android:id="@+id/newDeviceImageView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:padding="5dp">


                            <ImageView
                                android:id="@+id/newDeviceImage"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:srcCompat="@drawable/ics_icon_device" />

                        </RelativeLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_toRightOf="@+id/newDeviceImageView"
                            android:background="@xml/rounded_list_darker_blue"
                            android:orientation="vertical"
                            android:padding="5dp">

                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/newOptionText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/yourupgradeoption"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_medium_small"
                                app:firmatypeface="firmaBold" />


                            <com.watudrc.app.font.FirmaTextView
                                android:id="@+id/newDeviceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/name"
                                android:textColor="@color/theme_color"
                                android:textSize="@dimen/textsize_xsmall"
                                app:firmatypeface="firmaBold" />


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icSpecBatteryNew"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_battery" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/newDeviceBattery"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icSpecBatteryNew"
                                    android:text="@string/longerbatterylife"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icSpecCameraNew"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_camera" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/newDeviceCamera"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icSpecCameraNew"
                                    android:text="@string/bettercamera"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"

                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icSpecRomNew"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_ram" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/newDeviceRom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icSpecRomNew"
                                    android:text="@string/increasedstoragecapacity"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp">

                                <ImageView
                                    android:id="@+id/icRomNew"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_centerVertical="true"
                                    app:srcCompat="@drawable/ics_icon_rom" />


                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/newDeviceDisplay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/icRomNew"
                                    android:text="@string/fasterprocessing"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />


                            </RelativeLayout>


                            <RelativeLayout
                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:visibility="gone">

                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/downPaymentH"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:text="@string/downpayment"
                                    android:textColor="@color/theme_orange_light"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />

                                <com.watudrc.app.font.FirmaTextView
                                    android:id="@+id/deviceUpgradeAmount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_marginLeft="10dp"
                                    android:layout_toRightOf="@+id/downPaymentH"
                                    android:text="@string/amount"
                                    android:textColor="@color/theme_orange_light"
                                    android:textSize="@dimen/textsize_xsmall"
                                    app:firmatypeface="firmaBold" />

                            </RelativeLayout>
                            <!--  End of Upgrade Layout-->

                        </LinearLayout>


                    </RelativeLayout>

                </LinearLayout>


                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/upgradeRips"
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_below="@+id/comparisonView"
                    android:layout_marginTop="10dp"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnUpgrade"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_button">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/paynowtoupgrade"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>


                <com.watudrc.app.view.MaterialRippleLayout
                    android:id="@+id/upgradeWhatsappRips"
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_below="@+id/comparisonView"
                    android:layout_centerHorizontal="true"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="20dp"
                    android:visibility="gone"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnUpgradeWhatsApp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_button"
                        android:padding="5dp">

                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/chatwithus"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/notEligibleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/highlightView"
                android:padding="5dp"
                android:visibility="visible">


                <!-- Title -->
                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="@string/how_to_be_eligible_for_upgrade"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium_large"
                    android:textStyle="bold"
                    app:firmatypeface="firmaBold" />

                <!-- User Image -->
                <ImageView
                    android:id="@+id/userImage"
                    android:layout_width="228dp"
                    android:layout_height="238dp"
                    android:layout_below="@id/titleText"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_upgrade_eligible" />

                <!-- Description -->
                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/descText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/userImage"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
