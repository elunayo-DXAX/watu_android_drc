<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:background="@color/black"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/botView"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_below="@+id/limitView"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp">

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnCancel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_button_stroke">


                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/cancel"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp">

                <com.watudrc.app.view.MaterialRippleLayout
                    style="@style/RippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:rippleColor="@color/transparent">

                    <RelativeLayout
                        android:id="@+id/btnConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@xml/rounded_list_button">


                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/acceptText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/confirm"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaBold" />


                    </RelativeLayout>

                </com.watudrc.app.view.MaterialRippleLayout>


            </RelativeLayout>

        </LinearLayout>


        <RelativeLayout
            android:id="@+id/payView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/payH"
            android:layout_marginTop="5dp"
            android:gravity="bottom">


            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/payCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/payAmount"
                android:text="USD."
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_medium"
                app:firmatypeface="firmaLight" />

            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/payAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_toRightOf="@+id/payCurrency"
                android:text="150"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_large"
                app:firmatypeface="firmaBold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/limitView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fromNumber"
            android:layout_marginTop="10dp"
            android:visibility="gone">


            <ImageView
                android:id="@+id/iconEmergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:src="@drawable/ics_notification_bell" />

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@+id/iconEmergency"
                android:text="@string/amountlessthandaily"
                android:textColor="@color/theme_orange"
                android:textSize="@dimen/textsize_small"
                app:firmatypeface="firmaMedium" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/toolView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/backRips"
                style="@style/RippleStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_margin="10dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/icBack"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:visibility="visible"
                        app:srcCompat="@drawable/ics_back" />
                </RelativeLayout>
            </com.watudrc.app.view.MaterialRippleLayout>


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/iconView"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_below="@+id/toolView"
            android:layout_centerHorizontal="true"
            android:layout_margin="0dp"
            android:background="@drawable/rounded_list_transparent_orange_stroke"
            android:gravity="center"
            android:padding="0dp">

            <ImageView
                android:id="@+id/payIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="null"
                android:scaleType="center"
                android:src="@drawable/ics_icon_airtel" />


        </RelativeLayout>


        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/fromH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/payView"
            android:layout_marginTop="20dp"
            android:text="@string/from"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_small"
            app:firmatypeface="firmaLight" />

        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/fromNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fromH"
            android:layout_marginTop="5dp"
            android:text="254 700 000 000"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_large"
            app:firmatypeface="firmaBold" />

        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/payH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/paymentH"
            android:layout_marginTop="35dp"
            android:text="@string/pay"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_medium_small"
            app:firmatypeface="firmaMedium" />


        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/paymentH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iconView"
            android:layout_marginTop="30dp"
            android:text="@string/paymentconfirmation"
            android:textColor="@color/white"
            android:textSize="@dimen/textsize_medium_large"
            app:firmatypeface="firmaBold" />


        <include layout="@layout/loading_view_dialog" />


    </RelativeLayout>


</RelativeLayout>