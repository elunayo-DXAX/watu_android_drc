<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:padding="20dp">

        <RelativeLayout
            android:id="@+id/seekBarView"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp">


            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentRight="true"
                android:max="3"
                android:padding="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="1"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@color/transparent"></SeekBar>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/topView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/seekBarView"
            android:layout_marginTop="10dp">

            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:text="@string/gettingstarted"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_xlarge"
                app:firmatypeface="firmaBold" />

            <com.watudrc.app.font.FirmaTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/enterwatudetails"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_medium_small"
                app:firmatypeface="firmaMedium" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/topView"
            android:layout_marginTop="50dp"
            android:background="@xml/rounded_list_transparent_white_stroke"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/phoneNumberEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@+id/ccc"
                android:background="@color/transparent"
                android:gravity="left|center_vertical"
                android:hint="0000 000 000"
                android:imeOptions="actionDone"
                android:inputType="phone"
                android:minHeight="50dp"
                android:paddingLeft="10dp"
                android:singleLine="true"
                android:textColor="@color/theme_color"
                android:textColorHint="@color/theme_hint"
                android:textSize="@dimen/textsize_medium" />

            <ImageView
                android:id="@+id/ccc"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="15dp"
                android:src="@drawable/ics_country_drc"
                android:visibility="gone" />

            <com.hbb20.CountryCodePicker
                android:id="@+id/ccp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingLeft="15dp"
                android:visibility="gone"
                app:ccpDialog_searchEditTextTint="@color/theme_hint"
                app:ccpDialog_textColor="@color/theme_color"
                app:ccp_autoFormatNumber="false"
                app:ccp_customMasterCountries="CD"
                app:ccp_defaultNameCode="CD"
                app:ccp_showNameCode="false"
                app:ccp_showPhoneCode="false"
                app:ccp_textSize="@dimen/textsize_small" />


        </RelativeLayout>

        <com.watudrc.app.font.FirmaTextView
            android:id="@+id/idNumberH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/phone"
            android:layout_marginTop="20dp"
            android:text="@string/idnumberh"
            android:textColor="@color/theme_color"
            android:textSize="@dimen/textsize_small"
            android:visibility="gone"
            app:firmatypeface="firmaMedium" />

        <RelativeLayout
            android:id="@+id/idNumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/idNumberH"
            android:layout_marginTop="15dp"
            android:background="@xml/rounded_list_transparent_dark_light_small"
            android:gravity="center_vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/idNumberEditText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/transparent"
                android:gravity="left|center_vertical"
                android:hint="@string/idnumber"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:minHeight="50dp"
                android:paddingLeft="10dp"
                android:singleLine="true"
                android:textColor="@color/theme_color"
                android:textColorHint="@color/theme_hint"
                android:textSize="@dimen/textsize_small" />

        </RelativeLayout>

        <com.watudrc.app.view.MaterialRippleLayout
            android:id="@+id/resetRips"
            style="@style/RippleStyle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_below="@+id/idNumber"
            android:layout_marginTop="40dp"
            app:rippleColor="@color/transparent">

            <RelativeLayout
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@xml/rounded_list_button">

                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/enter"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaBold" />

            </RelativeLayout>

        </com.watudrc.app.view.MaterialRippleLayout>

        <RelativeLayout
            android:id="@+id/alreadyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/resetRips"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp">

            <RelativeLayout
                android:id="@+id/loginH"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <com.watudrc.app.font.FirmaTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alreadyhaveanaccount"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaBold" />


            </RelativeLayout>

            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/loginRips"
                style="@style/RippleStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="20dp"
                android:layout_toEndOf="@+id/loginH"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/logindot"
                        android:textColor="@color/theme_color"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaBold" />


                </RelativeLayout>

            </com.watudrc.app.view.MaterialRippleLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/guidanceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/alreadyView">

            <com.watudrc.app.view.MaterialRippleLayout
                android:id="@+id/challengeRips"
                style="@style/RippleStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="40dp"
                app:rippleColor="@color/transparent">

                <RelativeLayout
                    android:id="@+id/btnChallenge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@xml/rounded_list_button_black_dark">

                    <com.watudrc.app.font.FirmaTextView
                        android:id="@+id/issuesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/havingaproblemsignup"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaBold" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/issuesText"
                        android:src="@drawable/ics_help_icon"
                        android:tint="@color/theme_grey" />


                </RelativeLayout>

            </com.watudrc.app.view.MaterialRippleLayout>

            <com.synnapps.carouselview.CarouselView
                android:id="@+id/previewImagesView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="30dp"
                android:background="@color/black"
                android:visibility="gone"
                app:fillColor="@color/theme_color"
                app:indicatorMarginVertical="10dp"
                app:indicatorVisibility="gone"
                app:pageColor="@color/black"
                app:radius="5dp"
                app:slideInterval="8000"
                app:strokeColor="@color/theme_color"
                app:strokeWidth="1dp" />

        </RelativeLayout>


    </RelativeLayout>


    <include layout="@layout/loading_view" />

</RelativeLayout>