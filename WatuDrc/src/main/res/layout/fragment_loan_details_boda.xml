<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:background="@xml/rounded_list_black_light">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:padding="10dp">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:id="@+id/topView"
                android:layout_height="wrap_content">


                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/loanCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/watuboda"
                    android:textColor="@color/white"
                    android:textSize="@dimen/textsize_medium_small"
                    app:firmatypeface="firmaBold" />


                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/loanType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_alignParentRight="true"
                    android:text="@string/loantype"
                    android:textColor="@color/theme_color"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaBold" />

            </RelativeLayout>

            <ImageView
                android:id="@+id/div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/topView"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />


            <ImageView
                android:id="@+id/loanIcon"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:layout_below="@+id/div"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:src="@drawable/ics_boda" />



            <com.watudrc.app.font.FirmaTextView
                android:id="@+id/loanAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/loanIcon"
                android:layout_marginTop="15dp"
                android:text="USD.. 100,000"
                android:textColor="@color/white"
                android:textSize="@dimen/textsize_medium"
                app:firmatypeface="firmaBold" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_below="@+id/loanAmount"
                android:layout_marginTop="10dp"
                android:progress="40"
                android:max="100"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@color/transparent" >
            </SeekBar>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:weightSum="2"
                android:id="@+id/loanView"
                android:layout_centerHorizontal="true"
                android:layout_below="@+id/seekBar"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingRight="5dp"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/loanStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loanstatus"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />


                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/loanTypeH"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/loanStatus"
                            android:layout_marginTop="20dp"
                            android:text="@string/loantypeh"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/issueDateH"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/loanTypeH"
                            android:text="@string/issuedateh"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/maturityDateH"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/issueDateH"
                            android:text="@string/maturitydateh"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/maturityDateH"
                            android:text="@string/loanstatush"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />

                    </RelativeLayout>



                </RelativeLayout>


                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:paddingLeft="5dp"
                    android:gravity="right"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/asOf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/asof"
                            android:layout_marginRight="10dp"
                            android:layout_toLeftOf="@+id/refreshRips"
                            android:textColor="@color/white"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaMedium" />

                        <com.watudrc.app.view.MaterialRippleLayout
                            android:id="@+id/refreshRips"
                            style="@style/RippleStyle"
                            android:layout_alignParentRight="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:rippleColor="@color/transparent">

                            <RelativeLayout
                                android:id="@+id/btnRefresh"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent">


                                <ImageView
                                    android:layout_width="20dp"
                                    android:src="@drawable/ics_refresh"
                                    android:layout_height="20dp"/>


                            </RelativeLayout>

                        </com.watudrc.app.view.MaterialRippleLayout>




                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/loanTypeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/asOf"
                            android:layout_marginTop="20dp"
                            android:text="Watu Boda"
                            android:layout_alignParentRight="true"
                            android:textColor="@color/theme_color"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />





                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/issueDateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_alignParentRight="true"
                            android:layout_below="@+id/loanTypeText"
                            android:text="10th Jan, 2023"
                            android:textColor="@color/theme_color"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                        <com.watudrc.app.font.FirmaTextView
                            android:id="@+id/maturityDateText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_marginTop="5dp"
                            android:layout_below="@+id/issueDateText"
                            android:text="14th Nov, 2023"
                            android:textColor="@color/theme_green"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />


                        <com.watudrc.app.font.FirmaTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_alignParentRight="true"
                            android:layout_below="@+id/maturityDateText"
                            android:text="@string/overdue"
                            android:textColor="@color/theme_orange"
                            android:textSize="@dimen/textsize_small"
                            app:firmatypeface="firmaLight" />

                    </RelativeLayout>



                </RelativeLayout>



            </androidx.appcompat.widget.LinearLayoutCompat>


            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/amountView"
                android:layout_below="@+id/loanView"
                android:layout_marginTop="20dp"
                android:weightSum="2"
                android:layout_height="50dp">


                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:layout_height="match_parent">


                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/loanCurrency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ksh"
                    android:textColor="@color/theme_color"
                    android:textSize="@dimen/textsize_small"
                    app:firmatypeface="firmaLight" />


                <com.watudrc.app.font.FirmaTextView
                    android:id="@+id/loanBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/loanCurrency"
                    android:layout_marginLeft="5dp"
                    android:text="50,000"
                    android:textColor="@color/theme_color"
                    android:textSize="@dimen/textsize_large"
                    app:firmatypeface="firmaMedium" />


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:layout_height="match_parent">

                    <com.watudrc.app.view.MaterialRippleLayout
                        style="@style/RippleStyle"
                        android:layout_width="150dp"
                        android:layout_height="match_parent"
                        app:rippleColor="@color/transparent">

                        <RelativeLayout
                            android:id="@+id/btnPay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@xml/rounded_list_button">

                            <com.watudrc.app.font.FirmaTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="@string/pay"
                                android:textColor="@color/white"
                                android:textSize="@dimen/textsize_medium_small"
                                app:firmatypeface="firmaMedium" />


                        </RelativeLayout>

                    </com.watudrc.app.view.MaterialRippleLayout>

                </RelativeLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/div2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/amountView"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:background="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_below="@+id/div2"
                android:layout_marginTop="10dp"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:background="@xml/rounded_list_black"
                    android:padding="10dp"
                    android:layout_height="60dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:src="@drawable/ics_coins"
                        android:id="@+id/icC1"
                        android:layout_centerVertical="true"
                        android:layout_height="wrap_content"/>

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/icC1"
                        android:layout_centerVertical="true"
                        android:text="@string/totalpayment"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:text="USD. 100,000"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />



                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:background="@xml/rounded_list_black"
                    android:padding="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_height="60dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:src="@drawable/ics_coins"
                        android:id="@+id/icC2"
                        android:layout_centerVertical="true"
                        android:layout_height="wrap_content"/>

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/icC2"
                        android:layout_centerVertical="true"
                        android:text="@string/amountoverdue"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:text="USD. 50,000"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />



                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:background="@xml/rounded_list_black"
                    android:padding="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_height="60dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:src="@drawable/ics_coins"
                        android:id="@+id/icC3"
                        android:layout_centerVertical="true"
                        android:layout_height="wrap_content"/>

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/icC3"
                        android:layout_centerVertical="true"
                        android:text="@string/amountoverdue"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:text="USD. 10,000"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />



                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:background="@xml/rounded_list_black"
                    android:padding="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_height="60dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:src="@drawable/ics_coins"
                        android:id="@+id/icC4"
                        android:layout_centerVertical="true"
                        android:layout_height="wrap_content"/>

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/icC4"
                        android:layout_centerVertical="true"
                        android:text="@string/dailypayment"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:text="USD. 300"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />



                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:background="@xml/rounded_list_black"
                    android:padding="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_height="60dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:src="@drawable/ics_coins"
                        android:id="@+id/icC5"
                        android:layout_centerVertical="true"
                        android:layout_height="wrap_content"/>

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_toRightOf="@+id/icC5"
                        android:layout_centerVertical="true"
                        android:text="@string/installmentperiod"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />

                    <com.watudrc.app.font.FirmaTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:text="@string/week"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textsize_small"
                        app:firmatypeface="firmaLight" />



                </RelativeLayout>

            </LinearLayout>




        </RelativeLayout>






    </RelativeLayout>


    <include layout="@layout/loading_view" />

</RelativeLayout>